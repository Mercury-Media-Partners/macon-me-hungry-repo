---
import '../styles/global.css';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "OutATL — Atlanta's bilingual LGBTQ+ hub for residents, locals & World Cup 2026 visitors." } = Astro.props;
const isEs = Astro.url.pathname.startsWith('/es') || Astro.url.pathname.includes('/es/');
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;

// Calculate alternate URLs dynamically for SEO index mappings
const rawPath = Astro.url.pathname.replace(/^\/es(\/|$)/, '/');
const enUrl = new URL(rawPath, 'https://outatl.com').toString().replace(/\/$/, '') || 'https://outatl.com';
const esUrl = new URL('/es' + rawPath, 'https://outatl.com').toString().replace(/\/$/, '') || 'https://outatl.com/es';
---


<!doctype html>
<html lang={isEs ? "es" : "en"}>
	<head>
		<meta charset="UTF-8" />
		{umamiId && (
			<script defer src="https://cloud.umami.is/script.js" data-website-id={umamiId}></script>
		)}
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preload" href="/fonts/Outfit-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
		<link rel="preload" href="/fonts/PlusJakartaSans-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
		<slot name="preload" />

		<!-- Theme Initialization (Inline to prevent flash of wrong settings) -->
		<script is:inline>
			(function() {
				// Parse query params first
				const params = new URLSearchParams(window.location.search);
				const modeParam = params.get('mode');
				if (modeParam === 'tournament' || modeParam === 'night') {
					localStorage.setItem('outatl-mode', 'night');
				} else if (modeParam === 'community' || modeParam === 'day') {
					localStorage.setItem('outatl-mode', 'day');
				}

				// Theme
				const savedMode = localStorage.getItem('outatl-mode') || 'night';
				const root = document.documentElement;
				if (savedMode === 'day') {
					root.classList.remove('dark');
					root.classList.add('light');
				} else {
					root.classList.remove('light');
					root.classList.add('dark');
				}
			})();
		</script>
		<!-- Accessibility State Blocker (Inline to prevent flash of wrong styling) -->
		<script is:inline>
			(function() {
				if (localStorage.getItem('a11y-contrast') === 'true') {
					document.documentElement.classList.add('a11y-high-contrast');
				}
				if (localStorage.getItem('a11y-links') === 'true') {
					document.documentElement.classList.add('a11y-highlight-links');
				}
				if (localStorage.getItem('a11y-pause') === 'true') {
					document.documentElement.classList.add('a11y-pause-animations');
				}
			})();
		</script>

		
		<!-- SEO -->
		<title>{title} | OutATL</title>
		<meta name="description" content={description} />
		<meta name="author" content="OutATL Staff" />
		<meta name="robots" content="index, follow" />
		
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="x-default" href={enUrl} />
		<link rel="canonical" href={isEs ? esUrl : enUrl} />
		<slot name="head" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
	</head>
	<body class="bg-background text-foreground antialiased selection:bg-primary/30">
		<div id="app-content-wrapper">
			<slot />
		</div>
		
		{/* Mercury Accessibility Widget */}
		<AccessibilityWidget lang={isEs ? 'es' : 'en'} />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
	}

	html.onboarding-active body {
		overflow: hidden !important;
		height: 100vh !important;
	}

	html.onboarding-active #app-content-wrapper {
		filter: blur(12px) brightness(0.6);
		pointer-events: none !important;
		user-select: none !important;
		transition: filter 0.5s ease;
	}
</style>
