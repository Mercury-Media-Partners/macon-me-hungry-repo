---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import { EventsRadar } from '../components/events/EventsRadar';
import { VenueQuickDrawer } from '../components/directory/VenueQuickDrawer';
import { ItineraryBar } from '../components/directory/ItineraryBar';

const businesses = (await getCollection('businesses')).filter(b => !b.data.is_demo);
const standaloneEvents = await getCollection('events');

const eventsList = [
  ...businesses.flatMap(b => {
    if (!b.data.events) return [];
    return b.data.events.map((evt, idx) => ({
      id: `${b.id}-evt-${idx}`,
      venueId: b.id,
      venueTitle: b.data.title,
      venueNeighborhood: b.data.neighborhood,
      venueCategory: b.data.category,
      name: evt.name,
      day: evt.day,
      time: evt.time,
      description: evt.description,
      ticket_url: evt.ticket_url,
    }));
  }),
  ...standaloneEvents.map(evt => ({
    id: `standalone-${evt.id}`,
    venueId: 'standalone',
    venueTitle: evt.data.venueTitle,
    venueNeighborhood: evt.data.venueNeighborhood,
    venueCategory: evt.data.venueCategory,
    name: evt.data.name,
    day: evt.data.day,
    time: evt.data.time,
    description: evt.data.description,
    ticket_url: evt.data.ticket_url,
  }))
];

const combinedItems = businesses.map(b => ({ ...b, type: 'business' as const }));

const eventsJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Macon Local Events & Pop-ups",
  "itemListElement": eventsList.map((evt, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Event",
      "name": evt.name,
      "description": evt.description || `${evt.name} at ${evt.venueTitle} in ${evt.venueNeighborhood}`,
      "location": {
        "@type": "Place",
        "name": evt.venueTitle,
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Macon",
          "addressRegion": "GA"
        }
      }
    }
  }))
};
---

<Layout
  title="Macon Local Events & Pop-ups"
  description="Discover Macon's top local events, brewery pop-ups, trivia nights, and live music."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(eventsJsonLd)} />

  <Navbar />

  <main class="pt-32 pb-24 min-h-screen">
    <div class="container max-w-6xl mx-auto px-4">
      {/* Header */}
      <div class="mb-10 text-center md:text-left">
        <span class="section-label mb-2 block">Live Local Calendar</span>
        <h1 class="font-display text-4xl md:text-6xl text-foreground uppercase tracking-tight leading-none mb-4">
          MACON LOCAL EVENTS RADAR
        </h1>
        <p class="text-muted-foreground text-base md:text-lg max-w-2xl font-body">
          Brewery pop-ups, food truck festivals, trivia nights, and weekend specials handpicked across Downtown Macon, College Hill, and beyond.
        </p>
      </div>

      <EventsRadar events={eventsList} client:load />

      <VenueQuickDrawer businesses={combinedItems as any} client:idle />
      <ItineraryBar businesses={combinedItems as any} client:idle />
    </div>
  </main>

  <Footer />
</Layout>
