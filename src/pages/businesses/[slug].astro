---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EditorialHero from '../../components/business/EditorialHero.astro';
import SmartSidebar from '../../components/business/SmartSidebar.astro';
import SignatureItems from '../../components/business/SignatureItems.astro';
import ImpactDashboard from '../../components/business/ImpactDashboard.astro';
import EventsSection from '../../components/business/EventsSection.astro';
import Navbar from '../../components/navigation/Navbar.astro';
import Footer from '../../components/navigation/Footer.astro';

export async function getStaticPaths() {
  const businesses = await getCollection('businesses');
  return businesses.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

// Helper functions to generate valid ISO 8601 dates for Schema.org events
function getNextDayOfWeek(dayName: string): Date {
  const days: Record<string, number> = {
    sunday: 0, sun: 0,
    monday: 1, mon: 1,
    tuesday: 2, tue: 2,
    wednesday: 3, wed: 3,
    thursday: 4, thu: 4,
    friday: 5, fri: 5,
    saturday: 6, sat: 6
  };
  const normalized = dayName.toLowerCase().replace(/every\s+/i, '').split('&')[0].trim();
  const dayIndex = days[normalized] ?? 0;
  const today = new Date();
  const resultDate = new Date(today);
  resultDate.setDate(today.getDate() + (dayIndex + 7 - today.getDay()) % 7);
  return resultDate;
}

function parseTimeStr(timeStr: string): { hours: number; minutes: number } {
  timeStr = timeStr.trim().toLowerCase();
  const match = timeStr.match(/^(\d+)(?::(\d+))?\s*(am|pm)$/);
  if (!match) return { hours: 12, minutes: 0 };
  let hours = parseInt(match[1], 10);
  const minutes = match[2] ? parseInt(match[2], 10) : 0;
  const ampm = match[3];
  if (ampm === 'pm' && hours < 12) {
    hours += 12;
  } else if (ampm === 'am' && hours === 12) {
    hours = 0;
  }
  return { hours, minutes };
}

function getEventIsoDate(dayName: string, timeRangeStr: string, isEnd = false): string {
  const parts = timeRangeStr.split(/[-–—]/);
  const timeStr = isEnd && parts.length === 2 ? parts[1] : parts[0];
  const nextDate = getNextDayOfWeek(dayName);
  const { hours, minutes } = parseTimeStr(timeStr);
  nextDate.setHours(hours, minutes, 0, 0);
  const pad = (n: number) => String(n).padStart(2, '0');
  const year = nextDate.getFullYear();
  const month = pad(nextDate.getMonth() + 1);
  const day = pad(nextDate.getDate());
  const h = pad(nextDate.getHours());
  const m = pad(nextDate.getMinutes());
  return `${year}-${month}-${day}T${h}:${m}:00-04:00`;
}

// JSON-LD structured data for this business
const isFood = /restaurant|cafe|brewpub|bar|food|burger|bistro|diner|eatery/i.test(data.category);
const schemaType = isFood ? "Restaurant" : "LocalBusiness";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  "name": data.title,
  "description": data.meta_desc ?? data.tagline,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": data.address,
    "addressLocality": "Macon",
    "addressRegion": "GA",
    "addressCountry": "US"
  },
  ...(data.lat && data.lng && {
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": data.lat,
      "longitude": data.lng
    }
  }),
  ...(data.phone && { "telephone": data.phone }),
  ...(data.website && { "url": data.website }),
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": data.rating,
    "bestRating": 5
  },
  "openingHours": data.hours,
  "priceRange": data.tier === 'headliner' ? "$$$" : data.tier === 'promoter' ? "$$" : "$",
  ...(data.events && data.events.length > 0 && {
    "event": data.events.map(event => ({
      "@type": "Event",
      "name": `${event.name} at ${data.title}`,
      "description": event.description ?? data.tagline,
      "startDate": getEventIsoDate(event.day, event.time, false),
      "endDate": getEventIsoDate(event.day, event.time, true),
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      "location": {
        "@type": "Place",
        "name": data.title,
        "address": {
          "@type": "PostalAddress",
          "streetAddress": data.address,
          "addressLocality": "Macon",
          "addressRegion": "GA",
          "addressCountry": "US"
        }
      },
      ...(event.ticket_url && {
        "offers": {
          "@type": "Offer",
          "url": event.ticket_url,
          "price": "0",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock"
        }
      })
    }))
  })
};
---

<Layout title={data.meta_title || data.title} description={data.meta_desc}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <Navbar lang="en" />

  <main class="bg-background">
    <EditorialHero
      title={data.title}
      tagline={data.tagline}
      category={data.category}
      heroImage={data.heroImage}
      is_demo={data.is_demo}
    />

    <div class="container max-w-6xl mx-auto px-4 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
        {/* Main Content Area */}
        <div class="lg:col-span-2 space-y-16">

          {/* Headliner: Video Embed */}
          {data.video_url && (
            <div class={data.tier === 'headliner' ? "" : "locked-upsell-wrapper is-locked"} data-locked-tier="headliner">
              <div class="aspect-video rounded-2xl overflow-hidden border border-border mb-6">
                <iframe
                  src={data.video_url.replace('watch?v=', 'embed/')}
                  class="w-full h-full"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              </div>
              {data.tier !== 'headliner' && (
                <span class="text-[10px] text-muted-foreground/45 block text-center mb-6 locked-hint">
                  🔒 Video Header Locked (Headliner)
                </span>
              )}
            </div>
          )}

          {/* Headliner: Conversion CTA */}
          {data.cta_url && data.cta_label && (
            <div class={data.tier === 'headliner' ? "" : "locked-upsell-wrapper is-locked"} data-locked-tier="headliner">
              <a
                href={data.cta_url}
                target="_blank"
                rel="noopener"
                class="flex items-center justify-center gap-3 w-full py-5 rounded-2xl font-display text-2xl text-secondary-foreground tracking-wide uppercase transition-all hover:opacity-90 hover:scale-[1.01] glow-gold mb-6"
                style="background: var(--gradient-gold)"
              >
                🎟️ {data.cta_label}
              </a>
              {data.tier !== 'headliner' && (
                <span class="text-[10px] text-muted-foreground/45 block text-center mb-6 locked-hint">
                  🔒 Custom Conversion Button Locked (Headliner)
                </span>
              )}
            </div>
          )}

          {/* About / Story Section */}
          <section class="prose prose-invert prose-lg max-w-none">
            <h2 class="font-display text-4xl mb-8">The Story</h2>
            <Content />
          </section>

          {/* Events (Promoter & Headliner only) */}
          {data.events && data.events.length > 0 && (
            <div class={(data.tier === 'promoter' || data.tier === 'headliner') ? "" : "locked-upsell-wrapper is-locked"} data-locked-tier="promoter">
              <EventsSection events={data.events} tier={data.tier} lang="en" />
              {(data.tier !== 'promoter' && data.tier !== 'headliner') && (
                <span class="text-[10px] text-muted-foreground/45 block text-center mt-3 locked-hint">
                  🔒 Event Calendar Locked (Promoter)
                </span>
              )}
            </div>
          )}

          <ImpactDashboard
            jobs={data.jobs_supported}
            local_sourcing={data.local_sourcing}
            established={data.established}
            lang="en"
          />

          {data.order_highlights && (
            <SignatureItems items={data.order_highlights} lang="en" />
          )}
        </div>

        {/* Sidebar Area */}
        <div class="lg:col-span-1">
          <div class="sticky top-24">
            <SmartSidebar
              address={data.address}
              hours={data.hours}
              phone={data.phone}
              website={data.website}
              socials={data.socials}
              stadiumMin={data.stadiumMin}
              rating={data.rating}
              world_cup_ready={data.world_cup_ready}
              tier={data.tier}
              slug={entry.id}
              lang="en"
              transit_station={data.transit_station}
              transit_time_en={data.transit_time_en}
              transit_time_es={data.transit_time_es}
            />
          </div>
        </div>
      </div>
    </div>
  </main>

  {/* Floating Preview Banner */}
  <div id="preview-banner" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-accent/95 backdrop-blur-md text-white border border-accent/40 rounded-full py-3 px-6 shadow-deep flex items-center gap-3 z-[100] max-w-md text-center text-xs font-semibold uppercase tracking-wider font-label">
    <span>👀 Owner Preview Mode</span>
    <div class="h-4 w-px bg-white/30"></div>
    <a href="/list-your-business" class="underline hover:text-white/80 transition-colors">Unlock Page →</a>
  </div>

  <Footer lang="en" />
</Layout>

<script is:inline>
  (function() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('preview') === 'true') {
      // 1. Unlock all elements
      document.querySelectorAll('.locked-upsell-wrapper').forEach(el => {
        el.classList.remove('is-locked');
      });
      // 2. Hide lock notes
      document.querySelectorAll('.locked-hint').forEach(el => {
        el.classList.add('hidden');
      });
      // 3. Hide standard owner upgrade badge
      document.querySelectorAll('.claim-badge').forEach(el => {
        el.classList.add('hidden');
      });
      // 4. Show banner
      const banner = document.getElementById('preview-banner');
      if (banner) {
        banner.classList.remove('hidden');
      }
    }
  })();
</script>

<style is:global>
  .prose p {
    color: var(--color-muted-foreground);
    line-height: 1.625;
    margin-bottom: 1.5rem;
    font-family: var(--font-body);
  }
  .prose h2 {
    color: var(--color-foreground);
  }
  
  /* Lock layer styling */
  .locked-upsell-wrapper.is-locked {
    position: relative;
    filter: blur(2px) grayscale(40%);
    opacity: 0.35;
    pointer-events: none !important;
    user-select: none;
  }
  
  .locked-upsell-wrapper.is-locked a,
  .locked-upsell-wrapper.is-locked button {
    pointer-events: none !important;
    cursor: not-allowed !important;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translate(-50%, 10px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }
  #preview-banner:not(.hidden) {
    animation: fadeIn 0.4s ease-out forwards;
  }
</style>
