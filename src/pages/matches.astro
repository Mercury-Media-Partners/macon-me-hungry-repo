---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import GroupStageList from '../components/world-cup/GroupStageList.astro';
import TransitMap from '../components/world-cup/TransitMap.astro';
import { FanFestLineupWidget } from '../components/world-cup/FanFestLineupWidget';
import { en } from '../i18n/en';

const lang = "en";
const t = en;
---

<Layout title={`${t.matchHubTitle} | ${t.brand}`} description={t.matchHubDesc}>
  <Navbar lang={lang} />
  
  <main class="pt-32 pb-16 min-h-screen">
    <div class="container max-w-7xl mx-auto px-4">
      
      <!-- Hero / Header -->
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          Live Tracker
        </div>
        <h1 class="text-4xl md:text-6xl font-display font-bold tracking-tight mb-4 uppercase text-foreground">
          {t.matchHubTitle}
        </h1>
        <p class="text-xl text-muted-foreground max-w-3xl">
          {t.matchHubDesc}
        </p>
      </div>

      <FanFestLineupWidget client:load lang={lang} />

      <GroupStageList lang={lang} />
      
      <div class="mt-24 border-t border-border pt-12">
        <TransitMap lang={lang} />
      </div>


    </div>
  </main>
  
  <Footer lang={lang} />
</Layout>
