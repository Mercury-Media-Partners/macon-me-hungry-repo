---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/navigation/Navbar.astro';
import Footer from '../../components/navigation/Footer.astro';
import { FAQSection } from '../../components/list-business/FAQSection';
import { es } from '../../i18n/es';

const lang = "es";
const t = es;

const faqContent = {
  section_label: t.faqSectionLabel,
  title: t.faqPageTitle,
  items: t.productFaq,
};
---

<Layout title={`${t.faqPageTitle} | ${t.brand}`} description={t.faqPageDesc}>
  <Navbar lang={lang} />

  <main class="pt-32 pb-16 min-h-screen">
    <FAQSection content={faqContent} client:load />
  </main>

  <Footer lang={lang} />

  <script type="application/ld+json" set:text={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": t.productFaq.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  })} />
</Layout>
