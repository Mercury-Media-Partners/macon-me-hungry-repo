---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import { DirectoryFinder } from '../components/directory/DirectoryFinder';
import { InteractiveMap } from '../components/map/InteractiveMap';

const businesses = (await getCollection('businesses')).filter(b => !b.data.is_demo);

const heroImages = businesses
  .filter(b => b.data.heroImage)
  .map(b => b.data.heroImage as string)
  .sort(() => 0.5 - Math.random())
  .slice(0, 15);

const combinedItems = businesses.map(b => ({ ...b, type: 'business' as const }));

const tickerItems = [
  "EAT LOCAL",
  "SUPPORT MACON",
  "SOUTHERN HOSPITALITY",
  "MACON ME HUNGRY",
  "EAT LOCAL",
  "SUPPORT MACON",
  "SOUTHERN HOSPITALITY",
  "MACON ME HUNGRY",
];

// WebSite JSON-LD for homepage
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Macon Me Hungry",
  "url": "https://macon-me-hungry-repo.pages.dev",
  "description": "Discover the best restaurants, food trucks, and hidden gems in Macon, GA.",
  "inLanguage": "en",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://macon-me-hungry-repo.pages.dev/#bar-finder?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<Layout
  title="Home"
  description="Macon Me Hungry — Discover the best restaurants, food trucks, and hidden gems in Macon, GA."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(websiteJsonLd)} />

  <Navbar />

  <main>
    {/* Hero Section */}
    <section class="relative min-h-[70vh] flex items-center justify-center pt-28 pb-12 px-4 overflow-hidden bg-background">
      <div class="bg-pattern"></div>
      <div class="container max-w-6xl mx-auto text-center relative z-10 animate-fade-in text-foreground">
        
        <div>
          <h1 class="font-display text-5xl md:text-7xl text-foreground leading-none mb-8 tracking-tighter uppercase drop-shadow-xl">
            DISCOVER MACON'S <span class="text-gradient-primary">BEST BITES</span>
          </h1>
          <p class="text-foreground/90 text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed font-body drop-shadow-sm font-medium">
            Your curated guide to the greatest restaurants, food trucks, and hidden gems in Macon, GA.
          </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 150ms;">
            <a href="#bar-finder" class="btn btn-primary">
              FIND FOOD
            </a>
            <a href="#map" class="btn btn-secondary">
              EXPLORE MAP
            </a>
          </div>

          <!-- Quick Search -->
          <div class="mt-12 max-w-2xl mx-auto animate-slide-up" style="animation-delay: 200ms;">
            <form action="#bar-finder" method="get" class="flex flex-col sm:flex-row gap-2 bg-card/80 backdrop-blur-xl p-2 rounded-2xl border border-border shadow-2xl relative z-20">
              <input 
                type="text" 
                name="q"
                placeholder="Search by vibe, food, or name..."
                class="w-full px-4 py-2.5 bg-transparent text-foreground placeholder:text-muted-foreground focus:outline-none text-sm font-label"
              />
              <button type="submit" class="btn btn-primary">
                Search
              </button>
            </form>
            <div class="flex flex-wrap items-center justify-center gap-2 mt-4">
              <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider mr-2">Quick:</span>
              <a href="#bar-finder?filter=patio" class="px-2.5 py-1 rounded-md bg-muted hover:bg-muted-foreground/20 text-foreground transition-colors text-[11px]">🌳 Patios</a>
              <a href="#bar-finder?category=Soul Food" class="px-2.5 py-1 rounded-md bg-muted hover:bg-muted-foreground/20 text-foreground transition-colors text-[11px]">🍗 Soul Food</a>
              <a href="#bar-finder?category=Brewery" class="px-2.5 py-1 rounded-md bg-muted hover:bg-muted-foreground/20 text-foreground transition-colors text-[11px]">🍺 Breweries</a>
              <a href="#bar-finder?hood=downtown" class="px-2.5 py-1 rounded-md bg-muted hover:bg-muted-foreground/20 text-foreground transition-colors text-[11px]">📍 Downtown</a>
            </div>
          </div>
        </div>

        <p class="text-xs text-foreground/80 font-semibold mt-4 drop-shadow-sm">
          Own a local business?&nbsp;
          <a href="/list-your-business" class="text-foreground font-bold hover:opacity-80 transition-opacity underline underline-offset-2">
            Get your venue on the map →
          </a>
        </p>
      </div>

      </div>
    </section>

    {/* Marquee Ticker */}
    <div class="border-y border-foreground bg-foreground py-4 overflow-hidden">
      <div class="flex animate-marquee whitespace-nowrap gap-12 w-max">
        {[...tickerItems, ...tickerItems].map((item, i) => (
          <span key={i} class="text-xl text-primary font-bold uppercase tracking-widest font-display">
            {item}
          </span>
        ))}
      </div>
    </div>

    {/* Directory — with Dual State Master Switch */}
    <DirectoryFinder initialBusinesses={combinedItems} client:idle />

    {/* Interactive Map Section */}
    <div id="map" class="py-20 relative z-10 border-t border-border/30">
      <div class="container max-w-6xl mx-auto px-4">
        <div class="mb-12 text-center">
          <span class="section-label mb-3 block">Live Guide Map</span>
          <h2 class="font-display text-4xl md:text-6xl text-foreground uppercase tracking-tight leading-none mb-4">
            Interactive Neighborhood Map
          </h2>
          <p class="text-muted-foreground max-w-2xl mx-auto font-body text-base md:text-lg leading-relaxed">
            Navigate through Macon's vibrant neighborhoods and discover hidden culinary gems near you.
          </p>
        </div>
        <InteractiveMap client:visible />
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 35s linear infinite;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
  }
</style>
