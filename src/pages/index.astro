---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import { DirectoryFinder } from '../components/directory/DirectoryFinder';
import WorldCupSection from '../components/home/WorldCupSection.astro';
import { InteractiveMap } from '../components/map/InteractiveMap';
import IntentGrid from '../components/home/IntentGrid.astro';
import FanFestLineupBanner from '../components/world-cup/FanFestLineupBanner.astro';
import VideoHero from '../components/home/VideoHero.astro';
import { isPostWorldCup } from '../utils/transition';

const postWorldCup = isPostWorldCup();

const businesses = (await getCollection('businesses')).filter(b => !b.data.is_demo);

const heroImages = businesses
  .filter(b => b.data.heroImage)
  .map(b => b.data.heroImage as string)
  .sort(() => 0.5 - Math.random())
  .slice(0, 15);

const combinedItems = businesses.map(b => ({ ...b, type: 'business' as const }));

const tickerItems = [
  "🏳️‍🌈 Blake's on the Park",
  "⚽ Mundial 2026 · Atlanta",
  "🎭 Mary's EAV",
  "☕ FiNCA to FiLTER",
  "🔥 The Heretic",
  "💃 Lips Atlanta",
  "🌮 Guac y Margys",
  "🏠 Elements Atlanta",
  "🌎 Queer Atlanta 2026",
  "🍺 Bulldogs Bar",
];

// WebSite JSON-LD for homepage
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "OutATL",
  "url": "https://outatl.com",
  "description": "Atlanta's bilingual LGBTQ+ hub — nightlife, community, and culture for World Cup 2026.",
  "inLanguage": ["en", "es"],
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://outatl.com/#bar-finder?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<Layout
  title="Home"
  description={postWorldCup 
    ? "OutATL — Atlanta's bilingual LGBTQ+ hub. Find queer bars, cafes, services & events in Atlanta."
    : "OutATL — Atlanta's bilingual LGBTQ+ hub. Find queer bars, cafes, services & events for World Cup 2026."}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(websiteJsonLd)} />

  <Navbar lang="en" />

  <main>
    {/* Hero Section */}
    <section class="relative min-h-[90vh] flex items-center justify-center pt-28 pb-12 px-4 overflow-hidden bg-background">
      <VideoHero />

      <div class="container max-w-6xl mx-auto text-center relative z-10 animate-fade-in text-white">
        <span class="section-label mb-6 block drop-shadow-md">Atlanta's Bilingual Guide</span>
        
        <div>
          <h1 class="font-display text-7xl md:text-9xl text-white leading-none mb-8 tracking-tighter uppercase drop-shadow-xl">
            YOUR ATLANTA. <span class="text-gradient-primary">YOUR RULES.</span>
          </h1>
          <p class="text-white text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed font-body drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] font-medium">
            The independent guide to Atlanta’s curated lifestyle. Discover design-forward cafes, local retail, wellness spaces, and nightlife pockets handpicked for those out and about.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6">
            <a href="#bar-finder" class="px-8 py-4 bg-primary text-primary-foreground rounded-full font-label text-xl glow-primary hover:scale-105 transition-transform">
              Explore Directory
            </a>
            <a href="#map" class="px-8 py-4 bg-white/10 text-white border border-white/20 rounded-full font-label text-xl hover:bg-white/20 transition-all backdrop-blur-md">
              Explore Map
            </a>
          </div>

          {/* Hero Quick Search Integration */}
          <div class="max-w-xl mx-auto mt-8 p-3 rounded-2xl bg-black/50 border border-white/20 backdrop-blur-md shadow-2xl text-left">
            <form action="#bar-finder" class="flex items-center gap-2">
              <input
                type="text"
                name="search"
                placeholder="Search cafes, dance clubs, patios..."
                class="w-full px-4 py-2.5 bg-transparent text-white placeholder:text-white/60 focus:outline-none text-sm font-label"
              />
              <button type="submit" class="px-5 py-2.5 bg-primary text-primary-foreground font-bold rounded-xl text-xs uppercase tracking-wider font-label whitespace-nowrap glow-primary hover:scale-105 transition-transform">
                Search
              </button>
            </form>
            <div class="flex flex-wrap items-center gap-2 mt-3 pt-3 border-t border-white/10 text-xs">
              <span class="text-white/60 font-semibold uppercase text-[10px] tracking-wider">Quick:</span>
              <a href="#bar-finder?filter=patio" class="px-2.5 py-1 rounded-full bg-white/10 hover:bg-white/20 text-white/90 transition-colors text-[11px]">🌳 Patios</a>
              <a href="#bar-finder?category=Dance%20Club&mode=night" class="px-2.5 py-1 rounded-full bg-white/10 hover:bg-white/20 text-white/90 transition-colors text-[11px]">💃 Clubs</a>
              <a href="#bar-finder?category=Coffee%20Shop&mode=day" class="px-2.5 py-1 rounded-full bg-white/10 hover:bg-white/20 text-white/90 transition-colors text-[11px]">☕ Cafes</a>
              <a href="#bar-finder?hood=midtown" class="px-2.5 py-1 rounded-full bg-white/10 hover:bg-white/20 text-white/90 transition-colors text-[11px]">📍 Midtown</a>
            </div>
          </div>
        </div>

        <p class="text-xs text-white/80 mt-4 drop-shadow-sm">
          Own a local business?&nbsp;
          <a href="/list-your-business" class="text-primary hover:opacity-80 transition-opacity underline underline-offset-2">
            Get your venue on the map →
          </a>
        </p>
      </div>

      </div>
    </section>

    {/* Marquee Ticker */}
    <div class="border-y border-primary/20 bg-primary/5 py-4 overflow-hidden">
      <div class="flex animate-marquee whitespace-nowrap gap-12 w-max">
        {[...tickerItems, ...tickerItems].map((item, i) => (
          <span key={i} class="text-sm text-muted-foreground font-medium uppercase tracking-widest font-label">
            {item}
          </span>
        ))}
      </div>
    </div>

    {!postWorldCup && <FanFestLineupBanner lang="en" />}

    <IntentGrid lang="en" />

    {/* Directory — with Dual State Master Switch */}
    <DirectoryFinder initialBusinesses={combinedItems} client:idle lang="en" />



    {/* World Cup Survival Guide */}
    {!postWorldCup && (
      <div>
        <WorldCupSection lang="en" />
      </div>
    )}

    {/* Interactive Map Section */}
    <div id="map" class="py-20 relative z-10 border-t border-border/30">
      <div class="container max-w-6xl mx-auto px-4">
        <div class="mb-12 text-center">
          <span class="section-label mb-3 block">Live Guide Map</span>
          <h2 class="font-display text-4xl md:text-6xl text-foreground uppercase tracking-tight leading-none mb-4">
            Interactive Neighborhood Map
          </h2>
          <p class="text-muted-foreground max-w-2xl mx-auto font-body text-base md:text-lg leading-relaxed">
            Navigate through Atlanta's vibrant LGBTQ+ neighborhoods, public transit networks, and key match day destinations.
          </p>
        </div>
        <InteractiveMap client:visible lang="en" />
      </div>
    </div>
  </main>

  <Footer lang="en" />
</Layout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 35s linear infinite;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
  }
</style>
