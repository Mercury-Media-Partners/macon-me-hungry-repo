---
import { Trophy, Bus, Shield, Globe } from "lucide-react";

interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

---

<section id="worldcup" class="py-20 px-4 relative overflow-hidden bg-background">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-secondary/5 to-transparent pointer-events-none"></div>

  <div class="container max-w-6xl mx-auto relative">
    <div class="mb-12 text-center">
      <p class="section-label mb-2 text-secondary">{"World Cup 2026"}</p>
      <h2 class="font-display text-5xl md:text-7xl text-foreground leading-none mb-4 uppercase">
        {"THE OFFICIAL"}<br />
        <span class="text-gradient-gold uppercase">{"Survival Guide"}</span>
      </h2>
      <p class="text-muted-foreground max-w-2xl mx-auto italic font-body">
        {"Macon is a 2026 World Cup host city. This is your queer, bilingual guide to experiencing the matches the right way."}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bar-card p-6 flex gap-5 items-start">
        <div class="w-11 h-11 rounded-lg bg-secondary/15 border border-secondary/30 flex items-center justify-center text-secondary shrink-0">
          <Trophy size={22} />
        </div>
        <div>
          <h3 class="font-display text-xl text-foreground mb-2">
            {"Matches on the Big Screen"}
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed font-body">
            {"Many bars in our directory plan to show World Cup 2026 matches. Check with each venue to confirm their schedule."}
          </p>
        </div>
      </div>

      <div class="bar-card p-6 flex gap-5 items-start">
        <div class="w-11 h-11 rounded-lg bg-secondary/15 border border-secondary/30 flex items-center justify-center text-secondary shrink-0">
          <Bus size={22} />
        </div>
        <div>
          <h3 class="font-display text-xl text-foreground mb-2">
            {"Stadium to Bar"}
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed font-body">
            {"Mercedes-Benz Stadium is in Downtown, about 20 min by Uber to Midtown. MARTA's Green Line connects downtown to the bar district."}
          </p>
        </div>
      </div>

      <div class="bar-card p-6 flex gap-5 items-start">
        <div class="w-11 h-11 rounded-lg bg-secondary/15 border border-secondary/30 flex items-center justify-center text-secondary shrink-0">
          <Shield size={22} />
        </div>
        <div>
          <h3 class="font-display text-xl text-foreground mb-2">
            {"Is Midtown Macon Safe?"}
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed font-body">
            {"Yes. Midtown's Gayborhood is one of Macon's most welcoming and vibrant neighborhoods. Walkable at night."}
          </p>
        </div>
      </div>

      <div class="bar-card p-6 flex gap-5 items-start">
        <div class="w-11 h-11 rounded-lg bg-secondary/15 border border-secondary/30 flex items-center justify-center text-secondary shrink-0">
          <Globe size={22} />
        </div>
        <div>
          <h3 class="font-display text-xl text-foreground mb-2">
            {"Bilingual-Friendly Bars"}
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed font-body">
            {"Several bars in our directory have bilingual staff. Use the '💬 Bilingual Staff' filter in the directory to find them."}
          </p>
        </div>
      </div>
    </div>

    {/* FAQ Link */}
    <div class="mt-12 p-8 rounded-2xl border border-secondary/30 bg-secondary/5 text-center">
      <p class="font-display text-xl text-foreground mb-3">
        {"Have more questions about the World Cup?"}
      </p>
      <a
        href={`${""}/faq#world-cup-logistics`}
        class="inline-flex items-center gap-2 text-secondary font-bold uppercase text-sm tracking-wider hover:underline"
      >
        {"See our full FAQ"} →
      </a>
    </div>
  </div>
</section>
