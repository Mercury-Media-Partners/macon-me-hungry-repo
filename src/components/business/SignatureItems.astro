---
interface Props {
  items: { item: string; note: string }[];
  lang?: string;
}

const { items, lang = "en" } = Astro.props;

---

<div class="bg-muted/30 border border-border rounded-2xl p-8">
  <h3 class="font-display text-3xl mb-8 flex items-center gap-3">
    <span class="text-secondary">✦</span>
    {"What to Order"}
  </h3>

  <div class="grid gap-6">
    {items.map((item) => (
      <div class="group">
        <h4 class="font-display text-xl text-foreground group-hover:text-accent transition-colors mb-1">
          {item.item}
        </h4>
        <p class="text-sm text-muted-foreground leading-relaxed italic">
          — {item.note}
        </p>
      </div>
    ))}
  </div>
</div>
