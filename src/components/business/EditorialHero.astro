---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCategoryLabel } from '../../utils/categoryTranslations';

interface Props {
  title: string;
  tagline: string;
  category: string;
  heroImage?: string | ImageMetadata;
  is_demo?: boolean;
}

const { title, tagline, category, heroImage, is_demo } = Astro.props;
const isEs = Astro.url.pathname.startsWith('/es') || Astro.url.pathname.includes('/es/');
const lang = isEs ? "es" : "en";
const displayCategory = getCategoryLabel(category, lang);

// Content-collection `image()` fields resolve to an object at build time;
// legacy string paths (still used by `businesses`) render via the old <picture> fallback.
const isLocalAsset = typeof heroImage === "object";
---

<section class="relative h-[60vh] flex items-end pb-20 px-4 overflow-hidden">
  {/* Hero Background with dark overlay */}
  <div class="absolute inset-0 bg-background">
    {heroImage ? (
      isLocalAsset ? (
        <Image
          src={heroImage}
          alt={title}
          width={1600}
          height={900}
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 w-full h-full object-cover opacity-40"
        />
      ) : (
        <picture class="absolute inset-0 w-full h-full">
          <source srcset={heroImage.replace(/\.(jpg|jpeg|png)$/i, '.webp')} type="image/webp" />
          <img src={heroImage} alt={title} loading="eager" class="w-full h-full object-cover opacity-40" />
        </picture>
      )
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-background via-muted to-primary/10 opacity-60"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent"></div>
  </div>

  <div class="container max-w-6xl mx-auto relative z-10">
    <div class="animate-fade-up">
      <span class="inline-block px-3 py-1 rounded bg-primary/20 text-primary border border-primary/30 text-xs font-bold tracking-widest uppercase mb-4">
        {displayCategory}
      </span>
      {is_demo && (
        <span class="inline-block px-3 py-1 rounded bg-amber-500/20 text-amber-500 border border-amber-500/30 text-xs font-bold tracking-widest uppercase mb-4 ml-2">
          {isEs ? "Ejemplo de Anuncio" : "Example Listing"}
        </span>
      )}
      <h1 class="font-display text-7xl md:text-8xl lg:text-9xl text-foreground leading-none mb-4">
        {title}
      </h1>
      <p class="font-body text-xl md:text-2xl text-muted-foreground italic max-w-2xl border-l-4 border-primary pl-6 py-2">
        "{tagline}"
      </p>
    </div>
  </div>
</section>

<style>
  .animate-fade-up {
    animation: fadeUp 0.8s ease-out forwards;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
