---
interface Props {
  jobs?: number;
  local_sourcing?: string;
  established?: number;
  lang?: string;
}

const { jobs, local_sourcing, established, lang = "en" } = Astro.props;

---

<div class="border-y border-border py-12">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
    {jobs && (
      <div class="text-center">
        <p class="text-4xl font-display text-foreground leading-none mb-2">{jobs}</p>
        <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-bold">
          {"Local Jobs Supported"}
        </p>
      </div>
    )}
    
    {local_sourcing && (
      <div class="text-center">
        <p class="text-4xl font-display text-accent leading-none mb-2">{local_sourcing}</p>
        <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-bold">
          {"Georgia-Sourced Produce"}
        </p>
      </div>
    )}

    {established && (
      <div class="text-center">
        <p class="text-4xl font-display text-secondary leading-none mb-2">{established}</p>
        <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-bold">
          {"Anchoring Macon Since"}
        </p>
      </div>
    )}
  </div>
  
  <p class="mt-8 text-center text-[11px] text-muted-foreground max-w-lg mx-auto leading-relaxed italic">
    {'"Businesses like this are the backbone of our community. Their continued success ensures a resilient local economy."' }
  </p>
</div>
