---
// src/components/world-cup/TransitMap.astro
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;


const t = {
  eyebrow: "Transit & Access",
  title: "MARTA & Stadium Access",
  desc: "Navigate your way to Mercedes-Benz Stadium. Use this transit guide to trace MARTA rail lines, station exits, and downtown pedestrian pathways.",
  actionText: "Click map to expand & pan",
  listTitle: "Key Transit Connections",
  station1Title: "Dome/GWCC/Philips/CNN Station",
  station1Desc: "Direct access right outside the gates of Mercedes-Benz Stadium (Blue/Green Line).",
  station2Title: "Five Points Station",
  station2Desc: "Central transfer hub to connect all rail lines (Red, Gold, Blue, and Green Lines).",
  station3Title: "Peachtree Center Station",
  station3Desc: "The most convenient access point for downtown hotels and watch party zones."
};
---

<div class="glass-panel bg-card/50 backdrop-blur-md rounded-3xl p-6 md:p-8 border border-border">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    {/* Left Side: Editorial Guide */}
    <div class="lg:col-span-5 flex flex-col gap-5">
      <div>
        <span class="section-label mb-2 block">{t.eyebrow}</span>
        <h2 class="text-2xl md:text-3xl font-bold font-display tracking-tight text-foreground">{t.title}</h2>
        <p class="text-muted-foreground text-sm leading-relaxed mt-3">{t.desc}</p>
      </div>

      <div class="border-t border-border/40 pt-4">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-primary mb-4 font-label">{t.listTitle}</h3>
        <ul class="space-y-4">
          <li class="flex gap-3 items-start">
            <div class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-500/10 text-blue-400 font-bold text-xs shrink-0 mt-0.5">M</div>
            <div>
              <span class="block text-xs font-bold text-foreground font-label">{t.station1Title}</span>
              <span class="block text-xs text-muted-foreground mt-0.5">{t.station1Desc}</span>
            </div>
          </li>
          <li class="flex gap-3 items-start">
            <div class="flex items-center justify-center w-6 h-6 rounded-full bg-secondary/10 text-secondary font-bold text-xs shrink-0 mt-0.5">M</div>
            <div>
              <span class="block text-xs font-bold text-foreground font-label">{t.station2Title}</span>
              <span class="block text-xs text-muted-foreground mt-0.5">{t.station2Desc}</span>
            </div>
          </li>
          <li class="flex gap-3 items-start">
            <div class="flex items-center justify-center w-6 h-6 rounded-full bg-accent/10 text-accent font-bold text-xs shrink-0 mt-0.5">M</div>
            <div>
              <span class="block text-xs font-bold text-foreground font-label">{t.station3Title}</span>
              <span class="block text-xs text-muted-foreground mt-0.5">{t.station3Desc}</span>
            </div>
          </li>
        </ul>
      </div>
    </div>

    {/* Right Side: Map Preview Card */}
    <div class="lg:col-span-7">
      <button 
        type="button" 
        id="map-preview-btn" 
        class="group relative w-full aspect-[4/3] rounded-2xl overflow-hidden border border-border bg-black/40 flex items-center justify-center cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-primary/60 transition-transform duration-300 hover:scale-[1.01]"
        aria-label={t.actionText}
      >
        <img 
          src="/images/downtown-macon-tourist-map-max.webp" 
          alt={t.title} 
          class="w-full h-full object-cover object-center transition-all duration-700 opacity-90 group-hover:opacity-100 group-hover:scale-105"
          loading="lazy"
        />
        
        {/* Glow overlay */}
        <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-transparent opacity-80 transition-opacity duration-300 group-hover:opacity-60"></div>
        
        {/* Magnifying Glass Indicator */}
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-2.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/40">
          <div class="w-12 h-12 rounded-full bg-primary/20 backdrop-blur-md border border-primary/40 flex items-center justify-center text-primary glow-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
            </svg>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-white font-label">
            {t.actionText}
          </span>
        </div>
      </button>
    </div>

  </div>
</div>

{/* FULL SCREEN LIGHTBOX MODAL */}
<div 
  id="transit-map-modal" 
  class="fixed inset-0 z-[100] bg-zinc-950/95 flex flex-col items-center justify-center hidden opacity-0 transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
>
  {/* Modal Header Actions */}
  <div class="w-full max-w-7xl px-6 py-4 flex justify-between items-center z-10 shrink-0">
    <div class="flex flex-col gap-0.5">
      <span class="text-xs font-bold uppercase tracking-widest text-primary font-label">{t.eyebrow}</span>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white font-label">{t.title}</h2>
    </div>
    <button 
      id="map-modal-close" 
      class="w-10 h-10 rounded-full border border-white/10 bg-white/5 hover:bg-white/10 hover:border-white/20 transition-all flex items-center justify-center text-white cursor-pointer" 
      aria-label="Close"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  {/* Modal Main Viewport with Drag-to-Scroll Panning */}
  <div 
    id="map-scroll-container" 
    class="w-[92vw] h-[82vh] overflow-auto border border-white/10 bg-black rounded-2xl cursor-grab active:cursor-grabbing select-none relative no-scrollbar"
  >
    <img 
      src="/images/downtown-macon-tourist-map-max.webp" 
      alt="Full Size Tourist Map" 
      class="min-w-[1200px] md:min-w-[1800px] h-auto object-contain pointer-events-none"
    />
  </div>

  {/* Helper Hint */}
  <div class="py-3 text-[10px] text-muted-foreground uppercase tracking-widest font-label z-10 shrink-0">
    {"Click and Drag to Pan · Esc to Close"}
  </div>
</div>

<style>
  /* Hide scrollbar for clean map viewing experience */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const previewBtn = document.getElementById("map-preview-btn");
    const modal = document.getElementById("transit-map-modal");
    const closeBtn = document.getElementById("map-modal-close");
    const scrollContainer = document.getElementById("map-scroll-container");

    // Modal Visibility Handlers
    const openModal = () => {
      if (!modal) return;
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden"; // Block page scrolling
      setTimeout(() => {
        modal.classList.add("opacity-100");
      }, 10);
    };

    const closeModal = () => {
      if (!modal) return;
      modal.classList.remove("opacity-100");
      setTimeout(() => {
        modal.classList.add("hidden");
        document.body.style.overflow = ""; // Re-enable page scrolling
      }, 300);
    };

    previewBtn?.addEventListener("click", openModal);
    closeBtn?.addEventListener("click", closeModal);

    // Escape Key Listener
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });

    // Close on outside click
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Drag-to-Scroll Panning Logic (Desktop Mouse)
    if (scrollContainer) {
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let scrollLeft = 0;
      let scrollTop = 0;

      scrollContainer.addEventListener("mousedown", (e) => {
        const mouseEvent = e as MouseEvent;
        isDragging = true;
        scrollContainer.classList.remove("cursor-grab");
        scrollContainer.classList.add("cursor-grabbing");
        startX = mouseEvent.pageX - scrollContainer.offsetLeft;
        startY = mouseEvent.pageY - scrollContainer.offsetTop;
        scrollLeft = scrollContainer.scrollLeft;
        scrollTop = scrollContainer.scrollTop;
      });

      scrollContainer.addEventListener("mouseleave", () => {
        isDragging = false;
        scrollContainer.classList.remove("cursor-grabbing");
        scrollContainer.classList.add("cursor-grab");
      });

      scrollContainer.addEventListener("mouseup", () => {
        isDragging = false;
        scrollContainer.classList.remove("cursor-grabbing");
        scrollContainer.classList.add("cursor-grab");
      });

      scrollContainer.addEventListener("mousemove", (e) => {
        if (!isDragging) return;
        const mouseEvent = e as MouseEvent;
        mouseEvent.preventDefault();
        const x = mouseEvent.pageX - scrollContainer.offsetLeft;
        const y = mouseEvent.pageY - scrollContainer.offsetTop;
        const walkX = (x - startX) * 1.5; // Scroll speed multiplier
        const walkY = (y - startY) * 1.5;
        scrollContainer.scrollLeft = scrollLeft - walkX;
        scrollContainer.scrollTop = scrollTop - walkY;
      });
    }
  });
</script>
