---
// Pure Astro LanguageToggle — zero React, zero JS bundle weight
// Detects current language from the URL and builds the toggle href statically
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
---

<a
  id="lang-toggle-btn"
  href={isEs ? Astro.url.pathname.replace(/^\/es/, '') || '/' : `/es${Astro.url.pathname}`}
  class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-border bg-muted/50 text-xs font-bold transition-all hover:border-primary/50 group"
  aria-label={isEs ? 'Switch to English' : 'Cambiar al Español'}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-primary transition-colors" aria-hidden="true">
    <circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>
  </svg>
  <span class="tracking-widest uppercase">{isEs ? 'EN' : 'ES'}</span>
</a>
