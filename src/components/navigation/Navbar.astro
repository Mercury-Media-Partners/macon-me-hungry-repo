---

import { WeatherBadge } from './WeatherBadge';

interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

const base = "";

// Active-link detection (runs at SSR/SSG time — zero JS cost)
const path = Astro.url.pathname;
const isDirectoryActive = false; // It's an anchor link on the homepage, so we don't want it permanently highlighted when on /
const isBlogActive      = path.startsWith("/blog") || path.startsWith("/es/blog");
const isMapActive      = path.startsWith("/map") || path.startsWith("/es/map");
const isJobsActive     = path.startsWith("/jobs") || path.startsWith("/es/jobs");

const isEventsActive = path.startsWith("/events") || path.startsWith("/es/events");

const navLinks = [
  {
    href: `${base}/events`,
    label: "Events",
    active: isEventsActive,
  },
  {
    href: `${base}/#bar-finder`,
    label: "Directory",
    active: isDirectoryActive,
  },
  {
    href: `${base}/map`,
    label: "Map",
    active: isMapActive,
  },
  {
    href: `${base}/blog`,
    label: "Blog",
    active: isBlogActive,
  },
  {
    href: `${base}/jobs`,
    label: "Jobs",
    active: isJobsActive,
  },
];
---

<!-- Mobile Full-Screen Menu -->
<div
  id="nav-fullscreen-menu"
  class="nav-fullscreen-menu"
  role="dialog"
  aria-modal="true"
  aria-label={"Navigation menu"}
>
  <!-- Header with Close Button -->
  <div class="container max-w-6xl mx-auto px-4 h-16 flex items-center justify-between shrink-0">
    <a href={`${base}/`} class="flex items-center gap-2 font-display text-2xl tracking-widest text-foreground hover:text-primary transition-colors">
      <svg class="w-8 h-8 fill-current" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <path d="M 50 5 C 60 5, 65 10, 68 15 C 78 12, 85 18, 85 28 C 92 32, 95 40, 95 50 C 95 60, 92 68, 85 72 C 85 82, 78 88, 68 85 C 65 90, 60 95, 50 95 C 40 95, 35 90, 32 85 C 22 88, 15 82, 15 72 C 8 68, 5 60, 5 50 C 5 40, 8 32, 15 28 C 15 18, 22 12, 32 15 C 35 10, 40 5, 50 5 Z"/>
        <g transform="translate(50,50) rotate(45) translate(-50,-50)">
        <path d="M 38 25 L 38 45 A 12 12 0 0 0 62 45 L 62 25 L 56 25 L 56 42 A 6 6 0 0 1 44 42 L 44 25 Z" fill="var(--color-background)" />
        <rect x="38" y="25" width="6" height="20" rx="3" fill="var(--color-background)" />
        <rect x="47" y="25" width="6" height="20" rx="3" fill="var(--color-background)" />
        <rect x="56" y="25" width="6" height="20" rx="3" fill="var(--color-background)" />
        <rect x="46" y="55" width="8" height="35" rx="4" fill="var(--color-background)" />
        <path d="M 44 45 L 56 45 L 54 58 L 46 58 Z" fill="var(--color-background)" />
        </g>
        <g transform="translate(50,50) rotate(-45) translate(-50,-50)">
        <rect x="46" y="50" width="8" height="40" rx="4" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-width="4" />
        <rect x="46" y="50" width="8" height="40" rx="4" fill="var(--color-background)" />
        <ellipse cx="50" cy="35" rx="12" ry="18" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-width="3" />
        <ellipse cx="50" cy="35" rx="12" ry="18" fill="var(--color-background)" />
        </g>
      </svg>
      MACON ME HUNGRY
    </a>
    <button
      id="nav-close"
      aria-label={"Close menu"}
      class="p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-colors"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Centered Navigation Links -->
  <nav class="flex-1 flex flex-col items-center justify-center gap-6 overflow-y-auto">
    {navLinks.map(link => (
      <a
        href={link.href}
        class={`text-2xl font-bold uppercase tracking-widest transition-all duration-200 ${
          link.active ? "text-primary" : "text-muted-foreground hover:text-foreground"
        }`}
      >
        {link.label}
      </a>
    ))}
    <a
      href={`${base}/list-your-business`}
      class="text-2xl font-bold uppercase tracking-widest text-muted-foreground hover:text-foreground transition-all duration-200 mt-4"
    >
      {"List Your Business"}
    </a>
    <a
      href={`${base}/map`}
      class="btn btn-primary mt-4"
    >
      🗺️ {"Interactive Map"}
    </a>
  </nav>

  <!-- Footer Controls -->
  <div class="pb-10 pt-6 shrink-0 flex items-center justify-center gap-6">
    <WeatherBadge client:load lang={lang} />

      </div>
</div>

<!-- Announcement Banner -->
<div class="fixed top-0 left-0 right-0 h-9 z-[60] bg-secondary border-b border-secondary/50 py-2 px-4 text-center text-xs text-secondary-foreground font-bold flex items-center justify-center gap-2 drop-shadow-sm">
  <span class="truncate">
    {"🍖 Discover the best restaurants and food trucks in Macon, GA!"}
  </span>
  <a href={"/map"} class="underline underline-offset-2 hover:opacity-80 transition-opacity whitespace-nowrap ml-1.5">
    {"View Interactive Map →"}
  </a>
</div>

<!-- Main Navbar -->
<nav
  class="fixed top-9 left-0 right-0 z-50 border-b border-border/50 bg-background/80 backdrop-blur-md"
  aria-label={"Main navigation"}
>
  <div class="container max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a
      href={"/"}
      class="flex items-center gap-2 font-display text-2xl tracking-widest text-foreground hover:text-primary transition-colors shrink-0"
    >
      <svg class="w-8 h-8 fill-current" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <path d="M 50 5 C 60 5, 65 10, 68 15 C 78 12, 85 18, 85 28 C 92 32, 95 40, 95 50 C 95 60, 92 68, 85 72 C 85 82, 78 88, 68 85 C 65 90, 60 95, 50 95 C 40 95, 35 90, 32 85 C 22 88, 15 82, 15 72 C 8 68, 5 60, 5 50 C 5 40, 8 32, 15 28 C 15 18, 22 12, 32 15 C 35 10, 40 5, 50 5 Z"/>
        <g transform="translate(50,50) rotate(45) translate(-50,-50)">
        <path d="M 38 25 L 38 45 A 12 12 0 0 0 62 45 L 62 25 L 56 25 L 56 42 A 6 6 0 0 1 44 42 L 44 25 Z" fill="var(--color-background)" />
        <rect x="38" y="25" width="6" height="20" rx="3" fill="var(--color-background)" />
        <rect x="47" y="25" width="6" height="20" rx="3" fill="var(--color-background)" />
        <rect x="56" y="25" width="6" height="20" rx="3" fill="var(--color-background)" />
        <rect x="46" y="55" width="8" height="35" rx="4" fill="var(--color-background)" />
        <path d="M 44 45 L 56 45 L 54 58 L 46 58 Z" fill="var(--color-background)" />
        </g>
        <g transform="translate(50,50) rotate(-45) translate(-50,-50)">
        <rect x="46" y="50" width="8" height="40" rx="4" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-width="4" />
        <rect x="46" y="50" width="8" height="40" rx="4" fill="var(--color-background)" />
        <ellipse cx="50" cy="35" rx="12" ry="18" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-width="3" />
        <ellipse cx="50" cy="35" rx="12" ry="18" fill="var(--color-background)" />
        </g>
      </svg>
      MACON ME HUNGRY
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center gap-7">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${link.active ? "nav-link-active" : ""}`}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Desktop Right Controls -->
    <div class="hidden md:flex items-center gap-3">
      <WeatherBadge client:load lang={lang} />

            <a
        href={`${base}/map`}
        class="btn btn-primary text-[10px] px-4 py-2"
      >
        {"Interactive Map"}
      </a>
    </div>

    <!-- Mobile Right Controls (Weather & Hamburger) -->
    <div class="md:hidden flex items-center gap-2">
      <WeatherBadge client:load lang={lang} />
      <button
        id="nav-hamburger"
        aria-label={"Open navigation menu"}
        aria-expanded="false"
        aria-controls="nav-fullscreen-menu"
        class="p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-colors"
      >
        <!-- Hamburger icon -->
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>

  </div>
</nav>

<script is:inline>
  (function () {
    const hamburger = document.getElementById('nav-hamburger');
    const closeBtn  = document.getElementById('nav-close');
    const menu      = document.getElementById('nav-fullscreen-menu');
    if (!hamburger || !closeBtn || !menu) return;

    function openMenu() {
      menu.classList.add('nav-menu-open');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      // Focus first focusable element in menu
      const firstLink = menu.querySelector('a, button');
      if (firstLink) firstLink.focus();
    }

    function closeMenu() {
      menu.classList.remove('nav-menu-open');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      hamburger.focus();
    }

    hamburger.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('nav-menu-open')) {
        closeMenu();
      }
    });

    // Close menu on nav link click (SPA-style hash navigation)
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  })();
</script>
