---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;


const colors = ["#E40303", "#FF8C00", "#FFED00", "#008026", "#004DFF", "#750787"];

const basePath = "";
---

<footer id="about" class="border-t border-border bg-card/25 py-16 px-6 relative overflow-hidden">
  <!-- Dynamic grid background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>

  <div class="container max-w-6xl mx-auto relative z-10">
    <!-- 1. Verified Status Ticker Segment -->
    <div class="border border-border/40 bg-card/50 rounded-2xl px-6 py-4 mb-12 shadow-sm backdrop-blur-md">
      <div class="flex flex-col md:flex-row items-center justify-around gap-4 text-xs font-semibold tracking-wider uppercase text-muted-foreground/90">
        <div class="flex items-center gap-2">
          <span class="text-base">🍔</span>
          <span>{"Eat Local"}</span>
        </div>
        <div class="hidden md:block text-muted-foreground/20 text-lg">•</div>
        <div class="flex items-center gap-2">
          <span class="text-base">🤝</span>
          <span>{"Support Macon"}</span>
        </div>
        <div class="hidden md:block text-muted-foreground/20 text-lg">•</div>
        <div class="flex items-center gap-2">
          <span class="text-base">✨</span>
          <span>{"Good Vibes Only"}</span>
        </div>
      </div>
    </div>

    <!-- 2. Three-Column Middle Navigation Layout -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      
      <!-- Column 1: Identity & Motto -->
      <div class="flex flex-col items-center md:items-start space-y-4 text-center md:text-left">
        <a href={`${basePath}/`} class="flex items-center gap-2 font-display text-2xl tracking-widest text-foreground hover:text-primary transition-colors shrink-0">
          <svg class="w-8 h-8 fill-current" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <path d="M 50 5 C 60 5, 65 10, 68 15 C 78 12, 85 18, 85 28 C 92 32, 95 40, 95 50 C 95 60, 92 68, 85 72 C 85 82, 78 88, 68 85 C 65 90, 60 95, 50 95 C 40 95, 35 90, 32 85 C 22 88, 15 82, 15 72 C 8 68, 5 60, 5 50 C 5 40, 8 32, 15 28 C 15 18, 22 12, 32 15 C 35 10, 40 5, 50 5 Z"/>
            <g transform="translate(50,50) rotate(45) translate(-50,-50)">
            <path d="M 38 25 L 38 45 A 12 12 0 0 0 62 45 L 62 25 L 56 25 L 56 42 A 6 6 0 0 1 44 42 L 44 25 Z" fill="var(--color-background)" />
            <rect x="38" y="25" width="6" height="20" rx="3" fill="var(--color-background)" />
            <rect x="47" y="25" width="6" height="20" rx="3" fill="var(--color-background)" />
            <rect x="56" y="25" width="6" height="20" rx="3" fill="var(--color-background)" />
            <rect x="46" y="55" width="8" height="35" rx="4" fill="var(--color-background)" />
            <path d="M 44 45 L 56 45 L 54 58 L 46 58 Z" fill="var(--color-background)" />
            </g>
            <g transform="translate(50,50) rotate(-45) translate(-50,-50)">
            <rect x="46" y="50" width="8" height="40" rx="4" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-width="4" />
            <rect x="46" y="50" width="8" height="40" rx="4" fill="var(--color-background)" />
            <ellipse cx="50" cy="35" rx="12" ry="18" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-width="3" />
            <ellipse cx="50" cy="35" rx="12" ry="18" fill="var(--color-background)" />
            </g>
          </svg>
          MACON ME HUNGRY
        </a>
        <p class="text-sm text-muted-foreground leading-relaxed max-w-xs font-body">
          {"Your guide to the best bites in Macon, Georgia."}
        </p>
      </div>

      <!-- Column 2: Navigation Links -->
      <div class="grid grid-cols-2 gap-6">
        <div>
          <h4 class="text-xs font-bold text-foreground/80 uppercase tracking-widest font-label mb-4">
            {"Explore"}
          </h4>
          <ul class="space-y-2.5 text-sm font-body">
            <li>
              <a href={`${basePath}/#bar-finder`} class="text-muted-foreground hover:text-primary transition-colors">
                🗂️ {"Directory"}
              </a>
            </li>
            <li>
              <a href={`${basePath}/blog`} class="text-muted-foreground hover:text-primary transition-colors">
                ✍️ {"Blog"}
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-bold text-foreground/80 uppercase tracking-widest font-label mb-4">
            {"Tools"}
          </h4>
          <ul class="space-y-2.5 text-sm font-body">
            <li>
              <a href={`${basePath}/map`} class="text-muted-foreground hover:text-primary transition-colors">
                🗺️ {"Interactive Map"}
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Column 3: Partner & Support -->
      <div class="flex flex-col items-center md:items-start space-y-4 text-center md:text-left">
        <h4 class="text-xs font-bold text-foreground/80 uppercase tracking-widest font-label mb-1">
          {"Community & Support"}
        </h4>
        <ul class="space-y-2.5 text-sm font-body">
          <li>
            <a href={`${basePath}/list-your-business`} class="text-muted-foreground hover:text-primary transition-colors font-semibold">
              📢 {"Add Your Business"}
            </a>
          </li>
          <li>
            <a href={`${basePath}/faq`} class="text-muted-foreground hover:text-primary transition-colors">
              ❓ {"FAQ"}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- 3. Bottom Compliance & Copyright Row -->
    <div class="border-t border-border/30 pt-8 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-muted-foreground text-center md:text-left">
      <div>
        <p class="leading-relaxed font-body">
          {"© 2026 Macon Me Hungry. All rights reserved."}
        </p>
        <div class="mt-4 flex flex-wrap gap-4 items-center justify-center md:justify-start">
          <a href={`${basePath}/privacy`} class="hover:text-primary transition-colors">{"Privacy Policy"}</a>
          <a href={`${basePath}/terms`} class="hover:text-primary transition-colors">{"Terms of Service"}</a>
          <a href="/sitemap-index.xml" class="hover:text-primary transition-colors">{"Sitemap"}</a>
        </div>
      </div>

      <div class="flex flex-col md:items-end gap-1.5 font-label">
        <a 
          href="https://partnerwithmercury.com" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-[10px] font-bold text-muted-foreground/80 hover:text-primary transition-colors uppercase tracking-wider flex items-center gap-1"
        >
          <span>♿️</span> {"ADA Compliance & Digital Stewardship by Mercury Media Partners"}
        </a>
      </div>
    </div>
  </div>

  <!-- Full-width strip at the absolute bottom using brand color -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-primary"></div>
</footer>

